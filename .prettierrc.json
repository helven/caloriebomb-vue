{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "singleQuote": true,
  "quoteProps": "preserve",
  "singleAttributePerLine": false,
  "printWidth": 120,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["clsx", "cn"],
  "tailwindConfig": "./tailwind.config.js",
  "tabWidth": 4,
  "overrides": [
    {
      "files": [
        "**/*.yml",
        "**/*.html",
        "**/*.css",
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "**/*.json",
        "**/*.jsonc",
        "**/*.vue"
      ],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
